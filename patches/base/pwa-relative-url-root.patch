diff --git a/app/views/pwa/service-worker.js b/app/views/pwa/service-worker.js
index 4108a20..e6b35ce 100644
--- a/app/views/pwa/service-worker.js
+++ b/app/views/pwa/service-worker.js
@@ -1,8 +1,12 @@
 const CACHE_VERSION = 'v1';
+// Resolve against this script's own URL rather than the domain root, so the app
+// works when mounted under a sub-path (RAILS_RELATIVE_URL_ROOT): the worker is
+// served at <prefix>/service-worker, so 'offline.html' becomes <prefix>/offline.html.
+// Identical to the old root-absolute paths when the prefix is empty.
 const OFFLINE_ASSETS = [
-  '/offline.html',
-  '/logo-offline.svg'
-];
+  'offline.html',
+  'logo-offline.svg'
+].map((asset) => new URL(asset, self.location).pathname);
 
 // Install event - cache the offline page and assets
 self.addEventListener('install', (event) => {
@@ -41,7 +45,7 @@ self.addEventListener('fetch', (event) => {
       fetch(event.request).catch((error) => {
         // Only show offline page for network errors
         if (error.name === 'TypeError' || !navigator.onLine) {
-          return caches.match('/offline.html');
+          return caches.match(OFFLINE_ASSETS[0]);
         }
         throw error;
       })
