@@ -26,12 +26,18 @@
   <meta name="theme-color" content="#F9F9F9" media="(prefers-color-scheme: light)">
   <meta name="theme-color" content="#0B0B0B" media="(prefers-color-scheme: dark)">
 
+  <%# Mount prefix (RAILS_RELATIVE_URL_ROOT), "/" when hosted at the domain root.
+      Files under public/ are served by the web server, not the asset pipeline, so
+      they need this prefix spliced on by hand — and application.js reads it from
+      here to register the service worker at the right path. %>
+  <meta name="app-base-path" content="<%= root_path %>">
+
   <link rel="manifest" href="<%= pwa_manifest_path %>">
   <%# Provide multiple iOS icons (standard 180x180 and larger) %>
-  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
-  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
-  <link rel="apple-touch-icon" sizes="512x512" href="/logo-pwa.png">
-  <link rel="icon" sizes="192x192" type="image/png" href="/android-chrome-192x192.png">
+  <link rel="apple-touch-icon" href="<%= File.join(root_path, "apple-touch-icon.png") %>">
+  <link rel="apple-touch-icon" sizes="180x180" href="<%= File.join(root_path, "apple-touch-icon.png") %>">
+  <link rel="apple-touch-icon" sizes="512x512" href="<%= File.join(root_path, "logo-pwa.png") %>">
+  <link rel="icon" sizes="192x192" type="image/png" href="<%= File.join(root_path, "android-chrome-192x192.png") %>">
 
   <% if Rails.env.production? && (posthog_config = Rails.configuration.x.posthog).try(:api_key).present? %>
     <%= render "shared/posthog", posthog_api_key: posthog_config.api_key, posthog_host: posthog_config.host %>
